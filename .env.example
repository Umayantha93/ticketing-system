APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtppro.zoho.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@bookkara.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@bookkara.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_CLIENT_ID=

# PayHere Checkout (IPG)
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true
PAYHERE_CURRENCY=LKR
# Public URL PayHere can POST to (use ngrok/tunnel in local/dev)
PAYHERE_NOTIFY_URL="${APP_URL}/api/payments/payhere/notify"
FRONTEND_URL=http://localhost:3000
PAYHERE_RESERVATION_MINUTES=15
# true only for local sandbox when notify_url is localhost (never in production)
PAYHERE_TRUST_RETURN_IN_SANDBOX=false
# Optional Retrieval API (Settings → API Keys) — verifies payment on return/poll
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=

VITE_APP_NAME="${APP_NAME}"
